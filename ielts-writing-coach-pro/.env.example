# Copy these into Vercel: Project -> Settings -> Environment Variables. Never commit real values.

# Anthropic (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase (Project settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (Dashboard -> Settings -> Access Keys). Use the sandbox key until you go live.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# PayPal (developer.paypal.com -> Apps & Credentials). Leave empty to hide PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox
