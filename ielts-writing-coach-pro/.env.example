# Copy these into Vercel: Project -> Settings -> Environment Variables. Never commit real values.

# Anthropic (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase (Project settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (Dashboard -> Settings -> Access Keys). Use the sandbox key until you go live.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Which provider makes QRIS codes: midtrans (default) or dana
QRIS_PROVIDER=midtrans

# DANA Enterprise (dashboard.dana.id -> Developers). Only needed with QRIS_PROVIDER=dana.
DANA_ENV=sandbox
DANA_PARTNER_ID=
DANA_MERCHANT_ID=
DANA_SHOP_ID=
# The whole private.pem (multi-line is fine). Upload the matching public key to DANA.
DANA_PRIVATE_KEY=
# Optional: merchant category code. Default 8299 (schools and educational services).
# DANA_MCC=8299

# PayPal (developer.paypal.com -> Apps & Credentials). Leave empty to hide PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox
