# Copy these into Vercel: Project -> Settings -> Environment Variables. Never commit real values.

# Anthropic (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase (Project settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# DOKU (dashboard.doku.com -> Integration / API keys). Used for QRIS once DOKU_CLIENT_ID is set.
# Sandbox keys come from sandbox.doku.com; switch to production keys and DOKU_IS_PRODUCTION=true to go live.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
# Optional: payment methods shown on DOKU's page (default QRIS). Leave empty to show every method on your account.
# DOKU_PAYMENT_METHODS=QRIS
# Optional: force the QRIS provider (doku or midtrans). Default: doku when DOKU_CLIENT_ID is set.
# QRIS_PROVIDER=doku

# Midtrans (Dashboard -> Settings -> Access Keys). Use the sandbox key until you go live.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# PayPal (developer.paypal.com -> Apps & Credentials). Leave empty to hide PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox
